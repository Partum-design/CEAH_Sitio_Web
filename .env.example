# Credenciales SMTP de Titan (HostGator) para el formulario de contacto.
# Configúralas en Vercel > Project Settings > Environment Variables. No subas valores reales.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=ventas@ceahestructural.com.mx
SMTP_PASS=
# Respaldo: si Ventas falla, se envía con la cuenta de Dirección.
SMTP_FALLBACK_USER=direccion@ceahestructural.com.mx
SMTP_FALLBACK_PASS=
# Ventas y Dirección siempre reciben el formulario. Agrega aquí destinatarios extra separados por comas.
CONTACT_TO=
